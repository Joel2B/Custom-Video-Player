#!/usr/bin/env bash
set -euo pipefail
PATH=/usr/sbin:/usr/bin:/sbin:/bin
readonly PATH

TEMPLATE='/etc/cvp-deploy/player.conf.template'
CONFIG_DIR='/etc/cvp-deploy/nginx'
CONFIG="$CONFIG_DIR/default.conf"
RUN_DIR='/run/cvp-deploy'
CONTAINER='player'
IMAGE='nginx@sha256:b3c656d55d7ad751196f21b7fd2e8d4da9cb430e32f646adcf92441b72f82b14'
APP_DIR='/srv/cvp/player'

[ "$#" -eq 2 ]
DEPLOY_ID="$1"
SHA="$2"
printf '%s' "$DEPLOY_ID" | grep -Eq '^[0-9]{8}T[0-9]{6}Z-([a-f0-9]{8}|[a-f0-9]{32})$'
printf '%s' "$SHA" | grep -Eq '^[a-f0-9]{64}$'
BUNDLE="v1/deployments/$DEPLOY_ID/sha256/$SHA/player.min.js"
[ -f "$APP_DIR/$BUNDLE" ] && [ ! -L "$APP_DIR/$BUNDLE" ]
printf '%s  %s\n' "$SHA" "$APP_DIR/$BUNDLE" | sha256sum -c -
[ "$(realpath -e "$CONFIG_DIR")" = "$CONFIG_DIR" ]
[ ! -L "$CONFIG_DIR" ] && [ "$(stat -c '%U:%G:%a' "$CONFIG_DIR")" = 'root:root:755' ]
[ "$(realpath -e "$CONFIG")" = "$CONFIG" ]
[ ! -L "$CONFIG" ] && [ "$(stat -c '%U:%G:%a' "$CONFIG")" = 'root:root:644' ]

install -d -o root -g root -m 700 "$RUN_DIR"
[ "$(realpath -e "$RUN_DIR")" = "$RUN_DIR" ]
[ ! -L "$RUN_DIR" ] && [ "$(stat -c '%U:%G:%a' "$RUN_DIR")" = 'root:root:700' ]
temp="$(mktemp "$CONFIG_DIR/.default.conf.XXXXXXXXXX")"
backup="$(mktemp "$RUN_DIR/player.conf.backup.XXXXXXXXXX")"
trap 'rm -f -- "$temp" "$backup"' EXIT
sed "s|__CURRENT_LOCATION__|/$BUNDLE|" "$TEMPLATE" > "$temp"
chmod 644 "$temp"
grep -Fq "return 302 /$BUNDLE;" "$temp"
cp -f "$CONFIG" "$backup"

restore() {
  local restore_temp
  restore_temp="$(mktemp "$CONFIG_DIR/.default.conf.restore.XXXXXXXXXX")"
  cp "$backup" "$restore_temp"
  chmod 644 "$restore_temp"
  mv -fT "$restore_temp" "$CONFIG"
  timeout --kill-after=5s 30s docker exec "$CONTAINER" nginx -t
  timeout --kill-after=5s 30s docker exec "$CONTAINER" nginx -s reload
}

timeout --kill-after=5s 60s docker run --rm -v "$temp:/etc/nginx/conf.d/default.conf:ro" "$IMAGE" nginx -t
mv -fT "$temp" "$CONFIG"
if ! timeout --kill-after=5s 30s docker exec "$CONTAINER" nginx -t || ! timeout --kill-after=5s 30s docker exec "$CONTAINER" nginx -s reload; then
  restore
  exit 1
fi
