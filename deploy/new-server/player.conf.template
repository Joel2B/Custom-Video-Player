server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    server_name __DOMAIN__;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl default_server;
    server_name _;
    ssl_certificate __TLS_CERT__;
    ssl_certificate_key __TLS_KEY__;
    return 444;
}

server {
    listen 443 ssl;
    server_name __DOMAIN__;

    ssl_certificate __TLS_CERT__;
    ssl_certificate_key __TLS_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    absolute_redirect off;
    disable_symlinks on;
    root __ACTIVE_ROOT__;

    location = /v1/current/player.min.js {
        add_header Cache-Control "no-store" always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
        return 302 __CURRENT_LOCATION__;
    }

    location = /v1/testing/player.min.js {
        add_header Cache-Control "no-store" always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        return 302 __TESTING_LOCATION__;
    }

    location = /v1/stable/player.min.js {
        add_header Cache-Control "no-store" always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
        return 302 __STABLE_LOCATION__;
    }

    location ~ "^/v1/versions/(?<version>[0-9]+\.[0-9]+\.[0-9]+)/(?<asset>player\.min\.js|player\.min\.js\.LICENSE\.txt|release\.json)$" {
        root /srv/cvp;
        try_files $uri @version_not_found;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location @version_not_found {
        add_header Cache-Control "no-store" always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
        add_header X-Content-Type-Options "nosniff" always;
        return 404;
    }

    location ~* "^/v1/deployments/(?<deployment>[0-9]{8}T[0-9]{6}Z-(?:[a-f0-9]{8}|[a-f0-9]{32}))/(?<asset>(?:sha256/[a-f0-9]{64}/)?[^/]+\.(?:js|svg|txt))$" {
        root /srv/cvp/releases/$deployment;
        try_files $uri =404;
        add_header Cache-Control "public, max-age=604800" always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location = / {
        add_header Cache-Control "no-store" always;
        return 204;
    }

    location /v1/ {
        add_header Cache-Control "no-store" always;
        return 404;
    }

    location / {
        add_header Cache-Control "no-store" always;
        return 302 /;
    }
}
