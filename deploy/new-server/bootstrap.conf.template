server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    server_name __DOMAIN__;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl default_server;
    server_name _;
    ssl_certificate __TLS_CERT__;
    ssl_certificate_key __TLS_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    return 444;
}

server {
    listen 443 ssl;
    server_name __DOMAIN__;
    ssl_certificate __TLS_CERT__;
    ssl_certificate_key __TLS_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;

    add_header X-Content-Type-Options "nosniff" always;

    location = / {
        default_type text/html;
        add_header Cache-Control "no-store" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        return 200 '<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Custom Video Player tests</title><body><main><h1>Custom Video Player tests</h1><ul><li><a href="/tests/stable/">Stable release</a></li><li><a href="/tests/current/">Current commit</a></li><li><a href="/tests/testing/">Local testing</a></li></ul></main></body></html>';
    }

    location /tests/ {
        add_header Cache-Control "no-store" always;
        return 404;
    }

    location /v1/ {
        add_header Cache-Control "no-store" always;
        return 404;
    }

    location / {
        add_header Cache-Control "no-store" always;
        return 302 /;
    }
}
